#define ZMK_POINTING_DEFAULT_MOVE_VAL 1500  // default: 600
#define ZMK_POINTING_DEFAULT_SCRL_VAL 120    // default: 10 - for encoder mouse-scroll to work

#include <dt-bindings/zmk/mouse.h>
#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/pointing.h>

#define BASE 0
#define LOWER 1
#define RAISE 2
#define ADJUST 3

/ {
    conditional_layers {
        compatible = "zmk,conditional-layers";

        tri_layer {
            if-layers = <1 2>;
            then-layer = <3>;
        };
    };

    behaviors {
        enc_scroll: enc_scroll {
            compatible = "zmk,behavior-sensor-rotate-var";
            #sensor-binding-cells = <2>;
            bindings = <&msc>, <&msc>;

            tap-ms = <20>;
        };

        /* Setup SOCD for keys A and D (left and right) */
        /* SOCD Stands for: Simultaneous Opposing Cardinal Directions */

        SOCD: key_lip_a_d {
            compatible = "zmk,behavior-key-press-lip";
            #binding-cells = <1>;
            keycodes = <A D>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        default_layer {
            display-name = "base";

            // ------------------------------------------------------------------------------------------------------------------------------------------
            // | ESC   | ESC    |   `   |  1  |  2  |   3   |   4   |   5   |                   |   6   |   7   |   8   |  9  |  0  |  -  |  =  | BKSPC |
            // | COPY  | SCRCAP | TAB   |  Q  |  W  |   E   |   R   |   T   |                   |   Y   |   U   |   I   |  O  |  P  |  [  |  ]  |   \   |
            //         | GUI    | CAPS  |  A  |  S  |   D   |   F   |   G   |                   |   H   |   J   |   K   |  L  |  ;  |  '  |ENTER|
            // | PASTE | CTRL   | SHIFT |  Z  |  X  |   C   |   V   |   B   |  MUTE  | |  MUTE  |   N   |   M   |   ,   |  .  |  /  | ALT |CTRL |  DEL  |
            //                                      | SHIFT | SPACE | LOWER |                   | RAISE | SPACE | BKSPC |

            bindings = <
&kp ESC        &kp GRAVE     &kp N1      &kp N2   &kp N3  &kp N4    &kp N5     &kp N6                          &kp N7  &kp N8     &kp N9      &kp N0   &kp MINUS  &kp EQUAL   &kp BSPC   &kp BSPC
&kp LS(LG(S))  &kp LC(C)     &kp TAB     &kp Q    &kp W   &kp E     &kp R      &kp T                           &kp Y   &kp U      &kp I       &kp O    &kp P      &kp LBKT    &kp RBKT   &kp BSLH
               &kp LC(V)     &kp LSHIFT  &SOCD A  &kp S   &SOCD D   &kp F      &kp G                           &kp H   &kp J      &kp K       &kp L    &kp SEMI   &kp SQT     &kp ENTER
&kp CAPS       &kp LEFT_GUI  &kp LCTRL   &kp Z    &kp X   &kp C     &kp V      &kp B   &kp C_MUTE  &kp C_MUTE  &kp N   &kp M      &kp COMMA   &kp DOT  &kp FSLH   &kp RSHIFT  &kp RCTRL  &kp DEL
                                                          &kp LALT  &kp SPACE  &mo 1                           &mo 2   &kp SPACE  &kp RSHIFT
            >;

            sensor-bindings =
                <&enc_scroll SCRL_UP SCRL_DOWN>,
                <&inc_dec_kp C_VOL_UP C_VOL_DN>;
        };

        lower_layer {
            display-name = "lower";

            // --------------------------------------------------------------------------------------------------------------------------------------------
            // |BOOTLOADER| ESC    |   `   | F1 |  F2 |   F3  |   F4  |   F5  |                   |   F6  |   F7  |   F8  |  F9 | F10 |  F11 | F12  | BKSPC |
            // |  COPY    | SCRCAP | TAB   | Q  |  W  |   E   |   R   |   T   |                   |   Y   |   U   |   I   |  O  |  P  |   [  |  ]   |   \   |
            //            | GUI    | CAPS  | A  |  S  |   D   |   F   |   G   |                   |   H   |   J   |   K   |  L  |  ;  |   '  |  UP  |
            // |  PASTE   | CTRL   | SHIFT | Z  |  X  |   C   |   V   |   B   |  MUTE  | |  MUTE  |   N   |   M   |   ,   |  .  |  /  | LEFT | DOWN | RIGHT |
            //                                        | SHIFT | SPACE | LOWER |                   | RAISE | SPACE | BKSPC |

            bindings = <
&bootloader  &kp ESC    &kp KP_N1    &kp KP_N2    &kp KP_N3     &kp KP_N4        &kp KP_N5      &kp KP_N6                             &kp KP_N7         &kp KP_N8     &kp KP_N9  &kp KP_N0      &kp MINUS          &kp EQUAL  &kp BSPC    &kp BSPC
&none        &none      &kp TAB      &kp KP_PLUS  &kp KP_MINUS  &kp KP_MULTIPLY  &kp KP_DIVIDE  &kp KP_EQUAL                          &kp HOME          &kp RC(LEFT)  &kp UP     &kp RC(RIGHT)  &kp END            &kp PG_UP  &kp INSERT  &kp KP_NUMLOCK
             &none      &kp LS(TAB)  &none        &none         &none            &kp KP_DOT     &kp KP_ENTER                          &kp RS(RC(LEFT))  &kp LEFT      &kp DOWN   &kp RIGHT      &kp RC(RS(RIGHT))  &kp PG_DN  &kp UP
&tog 1       &kp LG(Z)  &kp LSHFT    &none        &none         &none            &none          &none         &kp C_MUTE  &kp C_MUTE  &kp RS(HOME)      &kp RC(BSPC)  &kp DEL    &kp RC(DEL)    &kp RS(END)        &kp LEFT   &kp DOWN    &kp RIGHT
                                                                &kp LSHFT        &kp SPACE      &trans                                &trans            &kp SPACE     &kp BSPC
            >;

            sensor-bindings =
                <&enc_scroll SCRL_UP SCRL_DOWN>,
                <&inc_dec_kp LA(TAB) LS(LA(TAB))>;
        };

        raise_layer {
            display-name = "raise";

            // ----------------------------------------------------------------------------------------------------------------------------------------------
            // | CLEAR | CLEAR  | CLEAR ALL | BT1 |  BT2 |  BT3  |  BT4  |  BT5  |                   |   F6  |   F7  |   F8  |  F9 | F10 |  F11       |  SCROLL UP  |  BOOTLOADER |
            // | COPY  | SCRCAP | TAB       | Q   |  W   |   E   |   R   |   T   |                   |   Y   |   U   |   I   |  O  |  P  |   [        | SCROLL DOWN | RIGHT CLICK |
            //         | GUI    | CAPS      | A   |  S   |   D   |   F   |   G   |                   |   H   |   J   |   K   |  L  |  ;  | LEFT CLICK |   MOUSE UP  |
            // | PASTE | CTRL   | SHIFT     | Z   |  X   |   C   |   V   |   B   |  MUTE  | |  MUTE  |   N   |   M   |   ,   |  .  |  /  | MOUSE LEFT |  MOUSE DOWN | MOUSE RIGHT |
            //                                           | SHIFT | SPACE | LOWER |                   | RAISE | SPACE | BKSPC |

            bindings = <
&bt BT_CLR      &bt BT_SEL 0  &kp F1           &kp F2     &kp F3     &kp F4     &kp F5     &kp F6                             &kp F7     &kp F8     &kp F9     &kp F10    &kp F11    &kp F12         &msc SCRL_UP    &bootloader
&bt BT_CLR_ALL  &bt BT_SEL 1  &kp LC(TAB)      &kp LC(Q)  &kp LC(W)  &kp LC(E)  &kp LC(R)  &kp LC(T)                          &kp RC(Y)  &kp RC(U)  &kp RC(I)  &kp LC(O)  &kp RC(P)  &mkp LCLK       &msc SCRL_DOWN  &mkp RCLK
                &bt BT_SEL 2  &kp LC(LS(TAB))  &kp LC(A)  &kp LC(S)  &kp LC(D)  &kp LC(F)  &kp LC(G)                          &kp LC(H)  &kp RC(J)  &kp RC(K)  &kp RC(L)  &kp SEMI   &mkp MCLK       &mmv MOVE_UP
&tog 2          &bt BT_SEL 3  &kp LSHFT        &kp LC(Z)  &kp LC(X)  &kp LC(C)  &kp LC(V)  &kp LC(B)  &kp C_MUTE  &kp C_MUTE  &mkp LCLK  &mkp RCLK  &kp COMMA  &kp DOT    &kp FSLH   &mmv MOVE_LEFT  &mmv MOVE_DOWN  &mmv MOVE_RIGHT
                                                                     &kp LSHFT  &kp SPACE  &trans                             &trans     &kp SPACE  &kp DEL
            >;

            sensor-bindings =
                <&enc_scroll SCRL_UP SCRL_DOWN>,
                <&inc_dec_kp RC(TAB) RC(RS(TAB))>;
        };

        adjust_layer {
            // ----------------------------------------------------------------------------------------------------------------------------------------------
            // | CLEAR | CLEAR  | CLEAR ALL | BT1 |  BT2 |  BT3  |  BT4  |  BT5  |                   |   F6  |   F7  |   F8  |  F9 | F10 |  F11       |  SCROLL UP  |   CLEAR     |
            // | COPY  | SCRCAP | TAB       | Q   |  W   |   E   |   R   |   T   |                   |   Y   |   U   |   I   |  O  |  P  |   [        | SCROLL DOWN | RIGHT CLICK |
            //         | GUI    | CAPS      | A   |  S   |   D   |   F   |   G   |                   |   H   |   J   |   K   |  L  |  ;  | LEFT CLICK |   MOUSE UP  |
            // | PASTE | CTRL   | SHIFT     | Z   |  X   |   C   |   V   |   B   |  MUTE  | |  MUTE  |   N   |   M   |   ,   |  .  |  /  | MOUSE LEFT |  MOUSE DOWN | MOUSE RIGHT |
            //                                           | SHIFT | SPACE | LOWER |                   | RAISE | SPACE | BKSPC |

            display-name = "adjust";
            bindings = <
&kp LS(LC(ESC))  &kp LG(H)  &kp C_AL_MY_COMPUTER  &kp C_AC_HOME  &kp C_AL_CALC  &kp LG(SEMI)  &kp C_BRI_DN  &kp C_BRI_UP                          &kp C_PREV  &kp C_PP   &kp C_NEXT        &kp C_STOP         &kp C_AC_SEARCH  &none           &msc SCRL_UP    &none
&none            &none      &kp TAB               &kp Q          &kp W          &kp E         &kp R         &kp T                                 &kp Y       &kp U      &kp I             &kp O              &kp P            &mkp LCLK       &msc SCRL_DOWN  &mkp RCLK
                 &none      &kp CAPS              &kp A          &kp S          &kp D         &kp F         &kp G                                 &kp H       &kp J      &kp K             &kp L              &kp SEMI         &mkp MCLK       &mmv MOVE_UP
&tog 3           &none      &none                 &kp Z          &kp X          &kp C         &kp V         &kp B         &kp C_MUTE  &kp C_MUTE  &kp N       &kp M      &kp RC(RS(LEFT))  &kp RC(RS(RIGHT))  &kp FSLH         &mmv MOVE_LEFT  &mmv MOVE_DOWN  &mmv MOVE_RIGHT
                                                                                &kp LSHFT     &kp SPACE     &trans                                &trans      &kp SPACE  &kp BSPC
            >;

            sensor-bindings =
                <&enc_scroll SCRL_UP SCRL_DOWN>,
                <&inc_dec_kp C_VOL_UP C_VOL_DN>;
        };
    };
};
